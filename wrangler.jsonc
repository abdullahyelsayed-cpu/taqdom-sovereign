{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taqdom-sovereign",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2025-04-01",
  "assets": {
    "directory": ".cf-assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/api/*",
      "/portfolio/*",
      "/@*",
      "/robots.txt",
      "/sitemap.xml"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "taqdom-db",
      "database_id": "1bd2685e-df2d-45c0-83b9-5a2d9f6f85d8"
    }
  ],
  "routes": [
    {
      "pattern": "taqdom.me/*",
      "zone_name": "taqdom.me"
    },
    {
      "pattern": "*.taqdom.me/*",
      "zone_name": "taqdom.me"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.2,
    "redact_query_string": true,
    "issues": {
      "enabled": true
    },
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 0.2,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true
    }
  }
}
