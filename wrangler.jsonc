{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taqdom-sovereign",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "taqdom.me",
      "custom_domain": true
    },
    {
      "pattern": "*.taqdom.me/*",
      "zone_name": "taqdom.me"
    }
  ],
  "observability": {
    "enabled": true
  }
}
